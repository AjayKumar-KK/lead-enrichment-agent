# Copy this file to .env and fill in your key.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
#
# .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# REQUIRED - get a free key at https://console.groq.com/keys (no card needed)
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_key_here

# ---------------------------------------------------------------------------
# Optional - everything below has a sensible default
# ---------------------------------------------------------------------------

# Model. Run `python run.py --list-models` to see what your key can call.
GROQ_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90
LLM_MAX_ATTEMPTS=3

# Crawling
MAX_PAGES_PER_DOMAIN=6
HTTP_TIMEOUT=20
BROWSER_TIMEOUT=30
DOMAIN_CONCURRENCY=3
PAGE_CONCURRENCY=3
POLITENESS_DELAY=0.4
MAX_FETCH_ATTEMPTS=3

# Token budget: hard character ceilings applied before any LLM call.
MAX_CHARS_PER_PAGE=6000
MAX_CHARS_PER_DOMAIN=24000

# ---------------------------------------------------------------------------
# LinkedIn search fallback
# ---------------------------------------------------------------------------
# When a team member is found with no profile link anywhere on the site, a search
# engine is queried for one. A result is only accepted when the person's name AND
# their company or role are corroborated in it, so a missing profile stays null
# rather than becoming a guess.
#
# Provider, in order of preference:
#   serper     - Google results via https://serper.dev (free tier, best quality).
#                Google is the only index that carries LinkedIn profiles in bulk.
#   brave-api  - https://api.search.brave.com (free tier), Brave's own index.
#   brave-html - keyless default. Works, but rate-limits after a few queries;
#                a block simply means "no match", never a failed run.
#   none       - make no outbound search requests at all.
LINKEDIN_SEARCH_ENABLED=true
LINKEDIN_SEARCH_PROVIDER=auto
# SERPER_API_KEY=
# BRAVE_API_KEY=

# How many people per domain may be looked up, and how confident a match must be.
LINKEDIN_SEARCH_MAX_LOOKUPS=5
LINKEDIN_MIN_CONFIDENCE=0.75
LINKEDIN_SEARCH_DELAY=1.2
LINKEDIN_SEARCH_TIMEOUT=15
LINKEDIN_SEARCH_RESULTS=6

# Output
OUTPUT_PATH=output/output.json
